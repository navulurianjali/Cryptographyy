#include <stdio.h>
#include <ctype.h>
#include <string.h>

int main()
{
    char text[100], key[27];
    int i, pos;

    printf("Enter plaintext: ");
    fgets(text, sizeof(text), stdin);

    printf("Enter 26-letter substitution key: ");
    scanf("%26s", key);

    if (strlen(key) != 26)
    {
        printf("Invalid key! Key must contain 26 letters.\n");
        return 1;
    }

    for (i = 0; i < 26; i++)
    {
        if (!isalpha((unsigned char)key[i]))
        {
            printf("Invalid key! Use alphabets only.\n");
            return 1;
        }

        key[i] = toupper((unsigned char)key[i]);
    }

    printf("Ciphertext: ");

    for (i = 0; text[i] != '\0'; i++)
    {
        if (isalpha((unsigned char)text[i]))
        {
            pos = toupper((unsigned char)text[i]) - 'A';

            if (islower((unsigned char)text[i]))
                printf("%c", tolower((unsigned char)key[pos]));
            else
                printf("%c", key[pos]);
        }
        else
        {
            printf("%c", text[i]);
        }
    }

    return 0;
}
