#include <stdio.h>
#include <string.h>
#include <ctype.h>

char matrix[5][5] = {
    {'M', 'F', 'H', 'I', 'K'},
    {'U', 'N', 'O', 'P', 'Q'},
    {'Z', 'V', 'W', 'X', 'Y'},
    {'E', 'L', 'A', 'R', 'G'},
    {'D', 'S', 'T', 'B', 'C'}
};

void findPosition(char ch, int *row, int *col)
{
    int i, j;

    if (ch == 'J')
        ch = 'I';

    for (i = 0; i < 5; i++)
    {
        for (j = 0; j < 5; j++)
        {
            if (matrix[i][j] == ch)
            {
                *row = i;
                *col = j;
                return;
            }
        }
    }
}

int main()
{
    char text[500], plain[500], cipher[600];
    int i, n = 0, k = 0;
    int r1, c1, r2, c2;

    printf("Enter plaintext:\n");
    fgets(text, sizeof(text), stdin);

    /* Display the given matrix */
    printf("\nPlayfair Matrix:\n");

    for (i = 0; i < 5; i++)
    {
        for (int j = 0; j < 5; j++)
            printf("%c ", matrix[i][j]);

        printf("\n");
    }

    /* Remove spaces and punctuation */
    for (i = 0; text[i] != '\0'; i++)
    {
        if (isalpha((unsigned char)text[i]))
        {
            char ch = toupper((unsigned char)text[i]);

            if (ch == 'J')
                ch = 'I';

            plain[n++] = ch;
        }
    }

    plain[n] = '\0';

    /* Prepare pairs of letters */
    for (i = 0; i < n;)
    {
        char a = plain[i];
        char b;

        if (i + 1 >= n)
        {
            b = 'X';
            i++;
        }
        else if (plain[i] == plain[i + 1])
        {
            b = 'X';
            i++;
        }
        else
        {
            b = plain[i + 1];
            i += 2;
        }

        findPosition(a, &r1, &c1);
        findPosition(b, &r2, &c2);

        /* Same row */
        if (r1 == r2)
        {
            cipher[k++] = matrix[r1][(c1 + 1) % 5];
            cipher[k++] = matrix[r2][(c2 + 1) % 5];
        }

        /* Same column */
        else if (c1 == c2)
        {
            cipher[k++] = matrix[(r1 + 1) % 5][c1];
            cipher[k++] = matrix[(r2 + 1) % 5][c2];
        }

        /* Rectangle rule */
        else
        {
            cipher[k++] = matrix[r1][c2];
            cipher[k++] = matrix[r2][c1];
        }
    }

    cipher[k] = '\0';

    printf("\nPlaintext: %s", plain);
    printf("\nCiphertext: %s\n", cipher);

    return 0;
}
