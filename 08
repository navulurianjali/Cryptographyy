#include <stdio.h>
#include <string.h>
#include <ctype.h>

char matrix[5][5];

void createMatrix(char key[])
{
    int used[26] = {0};
    int i, k = 0;
    char ch;

    used['J' - 'A'] = 1;

    for (i = 0; key[i] != '\0'; i++)
    {
        ch = toupper((unsigned char)key[i]);

        if (ch == 'J')
            ch = 'I';

        if (ch >= 'A' && ch <= 'Z' && !used[ch - 'A'])
        {
            matrix[k / 5][k % 5] = ch;
            used[ch - 'A'] = 1;
            k++;
        }
    }

    for (ch = 'A'; ch <= 'Z'; ch++)
    {
        if (!used[ch - 'A'])
        {
            matrix[k / 5][k % 5] = ch;
            k++;
        }
    }
}

void findPosition(char ch, int *r, int *c)
{
    int i, j;

    if (ch == 'J')
        ch = 'I';

    for (i = 0; i < 5; i++)
    {
        for (j = 0; j < 5; j++)
        {
            if (matrix[i][j] == ch)
            {
                *r = i;
                *c = j;
                return;
            }
        }
    }
}

int main()
{
    char key[100], text[500];
    int i, r1, c1, r2, c2;

    printf("Enter Playfair keyword: ");
    scanf("%99s", key);

    getchar();

    printf("Enter ciphertext: ");
    fgets(text, sizeof(text), stdin);

    createMatrix(key);

    printf("\nDecrypted plaintext:\n");

    for (i = 0; text[i] != '\0'; )
    {
        if (!isalpha((unsigned char)text[i]))
        {
            i++;
            continue;
        }

        char a = toupper((unsigned char)text[i++]);

        while (text[i] != '\0' &&
               !isalpha((unsigned char)text[i]))
            i++;

        if (text[i] == '\0')
            break;

        char b = toupper((unsigned char)text[i++]);

        findPosition(a, &r1, &c1);
        findPosition(b, &r2, &c2);

        if (r1 == r2)
        {
            printf("%c%c",
                   matrix[r1][(c1 + 4) % 5],
                   matrix[r2][(c2 + 4) % 5]);
        }
        else if (c1 == c2)
        {
            printf("%c%c",
                   matrix[(r1 + 4) % 5][c1],
                   matrix[(r2 + 4) % 5][c2]);
        }
        else
        {
            printf("%c%c",
                   matrix[r1][c2],
                   matrix[r2][c1]);
        }
    }

    return 0;
}
