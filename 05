#include <stdio.h>
#include <string.h>
#include <ctype.h>

int gcd(int a, int b)
{
    while (b != 0)
    {
        int temp = b;
        b = a % b;
        a = temp;
    }

    return a;
}

int main()
{
    char text[200];
    int a, b, i, p, c;

    printf("Enter plaintext: ");
    fgets(text, sizeof(text), stdin);

    printf("Enter a: ");
    scanf("%d", &a);

    printf("Enter b: ");
    scanf("%d", &b);

    a = (a % 26 + 26) % 26;
    b = (b % 26 + 26) % 26;

    if (gcd(a, 26) != 1)
    {
        printf("Invalid a! gcd(a,26) must be 1.\n");
        return 1;
    }

    printf("Ciphertext: ");

    for (i = 0; text[i] != '\0'; i++)
    {
        if (isupper((unsigned char)text[i]))
        {
            p = text[i] - 'A';
            c = (a * p + b) % 26;
            printf("%c", c + 'A');
        }
        else if (islower((unsigned char)text[i]))
        {
            p = text[i] - 'a';
            c = (a * p + b) % 26;
            printf("%c", c + 'a');
        }
        else
        {
            printf("%c", text[i]);
        }
    }

    return 0;
}
